+async def test_executor_silent_timeout_retries_with_doubled_limit(
+    tmp_path: Path, fake_nix: Path
+) -> None:
+    fake_nix.write_text("silent-once")
+    outcome, log = await run_build(
+        tmp_path, BuildSettings(log_dir=tmp_path, max_silent_time=600)
+    )
+    assert outcome == BuildOutcome.success
+    assert b"printed nothing for 600s, retrying once with 1200s" in log
+    assert b"--max-silent-time 1200" in log
+
+
+async def test_executor_silent_timeout_retries_once(
+    tmp_path: Path, fake_nix: Path
+) -> None:
+    fake_nix.write_text("silent")
+    outcome, _ = await run_build(tmp_path)
+    assert outcome == BuildOutcome.failure
+    assert (tmp_path / "runs").read_text().count("run") == 2
