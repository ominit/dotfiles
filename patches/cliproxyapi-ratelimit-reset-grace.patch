diff --git a/sdk/api/handlers/ratelimit_reset_grace.go b/sdk/api/handlers/ratelimit_reset_grace.go
new file mode 100644
index 0000000..ecd3081
--- /dev/null
+++ b/sdk/api/handlers/ratelimit_reset_grace.go
@@ -0,0 +1,106 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// rateLimitResetGrace is added to every reset time a 429 reports to clients,
+// so a client that retries exactly at the reset does not race a provider whose
+// clock runs slightly behind the reported deadline.
+const rateLimitResetGrace = time.Minute
+
+// ShouldExtendRateLimitReset reports whether an error response reports a
+// provider rate limit. A local concurrency-busy 429 keeps its short hint.
+func ShouldExtendRateLimitReset(status int, msg *interfaces.ErrorMessage) bool {
+	if status != http.StatusTooManyRequests {
+		return false
+	}
+	var busy *coreauth.HomeConcurrencyBusyError
+	return msg == nil || !errors.As(msg.Error, &busy)
+}
+
+// ExtendRateLimitResetHeaders pushes the Retry-After and provider reset
+// headers of a 429 response back by rateLimitResetGrace.
+func ExtendRateLimitResetHeaders(headers http.Header) {
+	for key, values := range headers {
+		lower := strings.ToLower(key)
+		var shift func(string) (string, bool)
+		switch {
+		case lower == "retry-after":
+			shift = shiftRetryAfter
+		case strings.HasPrefix(lower, "anthropic-ratelimit-unified-") && strings.HasSuffix(lower, "reset"),
+			strings.HasPrefix(lower, "x-codex-") && strings.HasSuffix(lower, "-reset-at"):
+			shift = shiftResetTimestamp
+		case strings.HasPrefix(lower, "x-codex-") && strings.HasSuffix(lower, "-reset-after-seconds"):
+			shift = shiftSeconds
+		default:
+			continue
+		}
+		for i, value := range values {
+			if shifted, ok := shift(strings.TrimSpace(value)); ok {
+				values[i] = shifted
+			}
+		}
+	}
+}
+
+// ExtendRateLimitResetBody pushes the resets_at and resets_in_seconds fields
+// of a 429 usage-limit error body back by rateLimitResetGrace.
+func ExtendRateLimitResetBody(body []byte) []byte {
+	if !gjson.ValidBytes(body) {
+		return body
+	}
+	grace := int64(rateLimitResetGrace / time.Second)
+	for _, path := range []string{"error.resets_at", "resets_at", "error.resets_in_seconds", "resets_in_seconds"} {
+		value := gjson.GetBytes(body, path)
+		if value.Type != gjson.Number || value.Int() <= 0 {
+			continue
+		}
+		if updated, errSet := sjson.SetBytes(body, path, value.Int()+grace); errSet == nil {
+			body = updated
+		}
+	}
+	return body
+}
+
+func shiftSeconds(value string) (string, bool) {
+	seconds, errParse := strconv.ParseInt(value, 10, 64)
+	if errParse != nil || seconds < 0 {
+		return "", false
+	}
+	return strconv.FormatInt(seconds+int64(rateLimitResetGrace/time.Second), 10), true
+}
+
+func shiftRetryAfter(value string) (string, bool) {
+	if shifted, ok := shiftSeconds(value); ok {
+		return shifted, true
+	}
+	at, errParse := http.ParseTime(value)
+	if errParse != nil {
+		return "", false
+	}
+	return at.Add(rateLimitResetGrace).UTC().Format(http.TimeFormat), true
+}
+
+func shiftResetTimestamp(value string) (string, bool) {
+	if unix, errParse := strconv.ParseInt(value, 10, 64); errParse == nil {
+		if unix <= 0 {
+			return "", false
+		}
+		return strconv.FormatInt(unix+int64(rateLimitResetGrace/time.Second), 10), true
+	}
+	at, errParse := time.Parse(time.RFC3339, value)
+	if errParse != nil {
+		return "", false
+	}
+	return at.Add(rateLimitResetGrace).Format(time.RFC3339), true
+}
