+async def test_branch_push_takes_over_merge_queue_build(pool: asyncpg.Pool) -> None:
+    project_id = await insert_project(pool, "mq-shed")
+    pr, _ = await db.get_or_create_build(
+        pool,
+        project_id,
+        "tree-q",
+        "sha",
+        "feature",
+        pr_number=5,
+        pr_author="github:alice",
+    )
+    queue, _ = await db.get_or_create_build(
+        pool, project_id, "tree-q", "sha", "gh-readonly-queue/main/pr-5-0123abcd"
+    )
+    main, created = await db.get_or_create_build(
+        pool, project_id, "tree-q", "sha", "main"
+    )
+    assert not created
+    assert pr.id_ == queue.id_ == main.id_
+    assert main.branch == "main"
+    assert main.merged_pr_number == 5
+    requeued, _ = await db.get_or_create_build(
+        pool, project_id, "tree-q", "sha", "gh-readonly-queue/main/pr-6-4567cdef"
+    )
+    assert requeued.branch == "main"
+
+
+async def test_branch_push_keeps_other_branch_build(pool: asyncpg.Pool) -> None:
+    project_id = await insert_project(pool, "branch-keep")
+    first, _ = await db.get_or_create_build(
+        pool, project_id, "tree-k", "sha", "release"
+    )
+    second, _ = await db.get_or_create_build(pool, project_id, "tree-k", "sha", "main")
+    assert second.id_ == first.id_
+    assert second.branch == "release"
+
+
