+class FakeUsage:
+    def __init__(self, free: int) -> None:
+        self.free = free
+
+
+def disk_full_settings(tmp_path: Path, **overrides: float) -> BuildSettings:
+    return BuildSettings(
+        log_dir=tmp_path,
+        disk_full_path=str(tmp_path),
+        disk_full_min_free=100,
+        disk_full_poll=0.01,
+        **overrides,
+    )
+
+
+async def test_executor_disk_full_retry_succeeds(
+    tmp_path: Path, fake_nix: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(executor_mod.shutil, "disk_usage", lambda _: FakeUsage(100))
+    fake_nix.write_text("diskfull-once")
+    outcome, log = await run_build(tmp_path, disk_full_settings(tmp_path))
+    assert outcome == BuildOutcome.success
+    assert b"ran out of disk space, retrying once there is room (1/3)" in log
+
+
+async def test_executor_disk_full_retries_are_capped(
+    tmp_path: Path, fake_nix: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(executor_mod.shutil, "disk_usage", lambda _: FakeUsage(100))
+    fake_nix.write_text("diskfull")
+    outcome, log = await run_build(tmp_path, disk_full_settings(tmp_path))
+    assert outcome == BuildOutcome.failure
+    assert (tmp_path / "runs").read_text().count("run") == 4
+    assert b"(3/3)" in log
+
+
+async def test_executor_disk_full_waits_for_free_space(
+    tmp_path: Path, fake_nix: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    free = iter([0, 0, 100])
+    checks: list[int] = []
+
+    def disk_usage(path: str) -> FakeUsage:
+        assert path == str(tmp_path)
+        checks.append(1)
+        return FakeUsage(next(free))
+
+    monkeypatch.setattr(executor_mod.shutil, "disk_usage", disk_usage)
+    fake_nix.write_text("diskfull-once")
+    outcome, _ = await run_build(tmp_path, disk_full_settings(tmp_path))
+    assert outcome == BuildOutcome.success
+    assert len(checks) == 3
+
+
+async def test_executor_disk_full_retries_after_wait_runs_out(
+    tmp_path: Path, fake_nix: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(executor_mod.shutil, "disk_usage", lambda _: FakeUsage(0))
+    fake_nix.write_text("diskfull-once")
+    outcome, _ = await run_build(
+        tmp_path, disk_full_settings(tmp_path, disk_full_wait=0.05)
+    )
+    assert outcome == BuildOutcome.success
+
+
+async def test_executor_disk_full_retries_when_free_space_is_unreadable(
+    tmp_path: Path, fake_nix: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def disk_usage(_: str) -> FakeUsage:
+        raise FileNotFoundError
+
+    monkeypatch.setattr(executor_mod.shutil, "disk_usage", disk_usage)
+    fake_nix.write_text("diskfull-once")
+    outcome, _ = await run_build(tmp_path, disk_full_settings(tmp_path))
+    assert outcome == BuildOutcome.success
+
+
+async def test_executor_cancel_during_disk_full_wait(
+    tmp_path: Path, fake_nix: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(executor_mod.shutil, "disk_usage", lambda _: FakeUsage(0))
+    fake_nix.write_text("diskfull")
+    cancel_event = asyncio.Event()
+    task = asyncio.create_task(
+        run_build(tmp_path, disk_full_settings(tmp_path), cancel_event)
+    )
+    while not (tmp_path / "runs").exists():  # noqa: ASYNC110
+        await asyncio.sleep(0.01)
+    await asyncio.sleep(0.05)
+    cancel_event.set()
+    outcome, _ = await asyncio.wait_for(task, timeout=5)
+    assert outcome == BuildOutcome.cancelled
+    assert (tmp_path / "runs").read_text().count("run") == 1
+
+
