+/// Sway reports `"name": null` for split, tabbed and stacked containers and
+/// `"app_id": null` for views without one, including every XWayland window.
+/// `#[serde(default)]` only covers a missing key, so without this one null
+/// fails the whole tree.
+fn null_as_default<'de, D, T>(deserializer: D) -> Result<T, D::Error>
+where
+    D: serde::Deserializer<'de>,
+    T: Default + Deserialize<'de>,
+{
+    Ok(Option::<T>::deserialize(deserializer)?.unwrap_or_default())
+}
