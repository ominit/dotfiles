+				}
+				candidate.Set(name, value)
+			}
+		}
+		if candidate != nil {
+			headers = candidate
+			bestNext = next
+		}
+	}
+	m.mu.RUnlock()
+	if headers == nil {
+		return err
+	}
+	replayed := *cooldown
+	replayed.replayHeaders = headers
+	return &replayed
+}
