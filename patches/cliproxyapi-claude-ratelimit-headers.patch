+func (m *Manager) withClaudeCooldownQuotaHeaders(err error, providers []string, model string) error {
+	cooldown, ok := err.(*modelCooldownError)
+	if !ok || cooldown == nil || m == nil || len(cooldown.replayHeaders) > 0 {
+		return err
+	}
+	claudeRequested := false
+	for _, provider := range providers {
+		if canonicalSchedulingProvider(provider) == "claude" {
+			claudeRequested = true
+			break
