+
+func claudeRateLimitResponseHeaders(src http.Header) http.Header {
+	var out http.Header
+	for key, values := range src {
+		canonical := http.CanonicalHeaderKey(key)
+		if len(values) == 0 || (canonical != "Retry-After" && !strings.HasPrefix(strings.ToLower(canonical), "anthropic-ratelimit-unified-")) {
