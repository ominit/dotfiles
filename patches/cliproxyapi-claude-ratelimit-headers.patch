 type claudeRateLimitError struct {
 	statusErr
 	credentialScoped bool
+	headers          http.Header
+}
+
+func (e claudeRateLimitError) Headers() http.Header {
+	return claudeRateLimitResponseHeaders(e.headers)
+}
+
+func claudeRateLimitResponseHeaders(src http.Header) http.Header {
+	var out http.Header
+	for key, values := range src {
+		canonical := http.CanonicalHeaderKey(key)
+		if len(values) == 0 || (canonical != "Retry-After" && !strings.HasPrefix(strings.ToLower(canonical), "anthropic-ratelimit-unified-")) {
+			continue
+		}
+		if out == nil {
+			out = make(http.Header)
+		}
+		out[canonical] = append([]string(nil), values...)
+	}
+	return out
 }
 
