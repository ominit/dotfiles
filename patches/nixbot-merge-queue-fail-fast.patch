+@dataclass
+class FailFirstExecutor(FakeExecutor):
+    """ "a" fails at once. The others wait for cancellation and succeed
+    if none arrives."""
+
+    async def build_attribute(  # noqa: PLR0913
+        self,
+        build_key: object,
+        job: NixEvalJobSuccess,
+        log_writer: LogWriter,
+        cwd: Path,
+        cancel_event: asyncio.Event | None = None,
+        on_start: Callable[[], Awaitable[bool]] | None = None,
+        on_built: Callable[[str], None] | None = None,
+        identity: EffectIdentity | None = None,
+        store: BuildStoreConfig | None = None,
+        priority: int = 0,
+    ) -> BuildOutcome:
+        if on_start is not None and not await on_start():
+            return BuildOutcome.cancelled
+        if job.attr == "a":
+            return BuildOutcome.failure
+        assert cancel_event is not None
+        try:
+            await asyncio.wait_for(cancel_event.wait(), timeout=1)
+        except TimeoutError:
+            return BuildOutcome.success
+        return BuildOutcome.cancelled
+
+
+async def _attr_statuses(pool: asyncpg.Pool, build_id: int) -> dict[str, str]:
+    rows = await pool.fetch(
+        "SELECT attr, status FROM build_attributes WHERE build_id = $1", build_id
+    )
+    return {r["attr"]: r["status"] for r in rows}
+
+
+async def test_merge_queue_build_stops_at_first_failure(
+    pool: asyncpg.Pool, make_env: EnvFactory, upstream: Path
+) -> None:
+    orchestrator, _, project = await make_env(
+        FakeEvalRunner([mk_job("a"), mk_job("b"), mk_job("c")]),
+        FailFirstExecutor(),
+        name="queued",
+    )
+    build = await orchestrator.handle_change_event(
+        ChangeEvent(
+            repo=project,
+            branch="gh-readonly-queue/main/pr-1-c0ffee",
+            commit_sha=git(upstream, "rev-parse", "HEAD"),
+        )
+    )
+    assert build is not None
+    assert await _attr_statuses(pool, build.id_) == {
+        "a": "failed",
+        "b": "cancelled",
+        "c": "cancelled",
+    }
+    status = await pool.fetchval("SELECT status FROM builds WHERE id = $1", build.id_)
+    assert status == BuildStatus.FAILED
+
+
+async def test_default_branch_build_keeps_going_after_a_failure(
+    pool: asyncpg.Pool, make_env: EnvFactory, upstream: Path
+) -> None:
+    orchestrator, _, project = await make_env(
+        FakeEvalRunner([mk_job("a"), mk_job("b")]),
+        FailFirstExecutor(),
+        name="unqueued",
+    )
+    build = await orchestrator.handle_change_event(
+        ChangeEvent(
+            repo=project,
+            branch="main",
+            commit_sha=git(upstream, "rev-parse", "HEAD"),
+        )
+    )
+    assert build is not None
+    assert await _attr_statuses(pool, build.id_) == {
+        "a": "failed",
+        "b": "succeeded",
+    }
+
+
