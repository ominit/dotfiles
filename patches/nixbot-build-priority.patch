diff --git a/nixbot/tests/test_build_priority.py b/nixbot/tests/test_build_priority.py
new file mode 100644
index 0000000..6589dc7
--- /dev/null
+++ b/nixbot/tests/test_build_priority.py
@@ -0,0 +1,35 @@
+"""Which builds take free build slots first."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from nixbot.build_run import build_priority
+from nixbot.events import ChangeEvent, RepoInfo
+
+REPO = RepoInfo(
+    id=1,
+    key="github/acme/widget",
+    name="acme/widget",
+    owner="acme",
+    repo="widget",
+    forge="github",
+    clone_url="",
+    default_branch="main",
+)
+
+
+def event(branch: str, **kwargs: Any) -> ChangeEvent:
+    return ChangeEvent(repo=REPO, branch=branch, commit_sha="c0ffee", **kwargs)
+
+
+def test_merge_queue_and_default_branch_go_first() -> None:
+    assert build_priority(event("main")) == 1
+    assert build_priority(event("gh-readonly-queue/main/pr-151-fb841fb3")) == 1
+
+
+def test_pull_requests_tags_and_other_branches_wait() -> None:
+    # PR builds carry the base branch.
+    assert build_priority(event("main", pr_number=151)) == 0
+    assert build_priority(event("main", tag="main")) == 0
+    assert build_priority(event("feature")) == 0
diff --git a/nixbot/tests/test_executor.py b/nixbot/tests/test_executor.py
index 192c91d..4d9fe5f 100644
--- a/nixbot/tests/test_executor.py
+++ b/nixbot/tests/test_executor.py
@@ -74,6 +74,44 @@ async def test_fair_round_robin_across_builds() -> None:
     assert order == ["a1", "b1", "a2", "b2", "a3"]
 
 
+async def test_fair_scheduler_serves_higher_priority_first() -> None:
+    queue = FairScheduler(1)
+    order: list[str] = []
+    await queue.acquire("seed")
+
+    async def worker(name: str, key: str, priority: int) -> None:
+        await queue.acquire(key, priority)
+        order.append(name)
+        queue.release()
+
+    # PR builds queue first; the merge-queue builds still go ahead of them
+    # and alternate with each other.
+    tasks = [
+        asyncio.create_task(worker("pr1", "PR", 0)),
+        asyncio.create_task(worker("pr2", "PR", 0)),
+        asyncio.create_task(worker("q1", "Q", 1)),
+        asyncio.create_task(worker("m1", "M", 1)),
+        asyncio.create_task(worker("q2", "Q", 1)),
+    ]
+    await asyncio.sleep(0)
+    queue.release()
+    await asyncio.gather(*tasks)
+    assert order == ["q1", "m1", "q2", "pr1", "pr2"]
+
+
+async def test_fair_scheduler_cancelled_priority_waiter() -> None:
+    queue = FairScheduler(1)
+    await queue.acquire("A")
+    waiter = asyncio.create_task(queue.acquire("Q", 1))
+    low = asyncio.create_task(queue.acquire("B"))
+    await asyncio.sleep(0)
+    waiter.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await waiter
+    queue.release()
+    await asyncio.wait_for(low, timeout=1)
+
+
