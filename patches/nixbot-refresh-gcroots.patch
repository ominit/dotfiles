diff --git a/nixbot/gcroots.py b/nixbot/gcroots.py
index dd89600..1729fff 100644
--- a/nixbot/gcroots.py
+++ b/nixbot/gcroots.py
@@ -137,3 +137,10 @@ def _touch(path: Path) -> None:
         os.utime(path, follow_symlinks=False)
     except OSError:
         logger.warning("failed to refresh gcroot mtime", extra={"path": str(path)})
+
+
+def refresh_gcroots(root_dir: Path) -> None:
+    """Reset the age of every root in `root_dir`."""
+    for entry in root_dir.iterdir():
+        if entry.is_symlink():
+            _touch(entry)
