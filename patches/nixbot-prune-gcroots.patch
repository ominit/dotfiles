+async def prune_gcroots(
+    o: Orchestrator, event: ChangeEvent, attrs: Collection[str]
+) -> None:
+    """Drop the push's roots of attributes its complete evaluation no
+    longer has (renamed or removed from the flake)."""
+    repo = event.repo
+    if event.pr_number is not None or not attrs:
+        # No attributes at all more likely means a broken flake than
+        # one with nothing left to build.
+        return
+    if not o.config.branches.do_register_gcroot(repo.default_branch, event.branch):
+        return
+    project = gcroot_project(repo.key, event.branch, event.tag)
+    removed = await asyncio.to_thread(
+        remove_stale_gcroots, o.config.gcroots_dir, project, attrs
+    )
+    if removed:
+        logger.info(
+            "removed gcroots of attributes no longer evaluated",
+            extra={"project": project, "attrs": removed},
+        )
 
 
