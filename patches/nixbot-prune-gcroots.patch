+def remove_stale_gcroots(
+    gcroots_dir: Path, project: str, attrs: Collection[str]
+) -> list[str]:
+    """Remove the project's roots of attributes outside `attrs`.
+    Returns the attributes whose roots were removed."""
+    keep = {safe_attr_filename(attr) for attr in attrs}
+    try:
+        entries = list((gcroots_dir / project).iterdir())
+    except FileNotFoundError:
+        return []
+    removed = []
+    for entry in entries:
+        if entry.is_symlink() and entry.name not in keep:
+            entry.unlink(missing_ok=True)
+            removed.append(unquote(entry.name))
+    return sorted(removed)
+
+
