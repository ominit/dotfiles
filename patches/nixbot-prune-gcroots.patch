+def _seed_roots(orchestrator: Orchestrator, project: RepoInfo) -> Path:
+    root_dir = orchestrator.config.gcroots_dir / gcroot_project(project.key, "main")
+    root_dir.mkdir(parents=True)
+    for attr in ("a", "removed"):
+        (root_dir / attr).symlink_to("/nix/store/abc")
+    return root_dir
+
+
+async def test_main_build_removes_roots_of_removed_attributes(
+    make_env: EnvFactory, upstream: Path
+) -> None:
+    add_commit(upstream, "prune")
+    orchestrator, _, project = await make_env(
+        FakeEvalRunner([mk_job("a")]), FakeExecutor(), name="prune"
+    )
+    root_dir = _seed_roots(orchestrator, project)
+    build = await orchestrator.handle_change_event(
+        ChangeEvent(
+            repo=project, branch="main", commit_sha=git(upstream, "rev-parse", "HEAD")
+        )
+    )
+    assert build is not None
+    assert [p.name for p in root_dir.iterdir()] == ["a"]
+
+
+async def test_main_push_reusing_a_build_removes_roots_of_removed_attributes(
+    make_env: EnvFactory, upstream: Path
+) -> None:
+    add_commit(upstream, "prune-reuse")
+    sha = git(upstream, "rev-parse", "HEAD")
+    orchestrator, _, project = await make_env(
+        FakeEvalRunner([mk_job("a")]), FakeExecutor(), name="prune-reuse"
+    )
+    root_dir = _seed_roots(orchestrator, project)
+    pr_build = await orchestrator.handle_change_event(
+        ChangeEvent(repo=project, branch="main", commit_sha=sha, pr_number=7)
+    )
+    assert pr_build is not None
+    assert sorted(p.name for p in root_dir.iterdir()) == ["a", "removed"]
+    main_build = await orchestrator.handle_change_event(
+        ChangeEvent(repo=project, branch="main", commit_sha=sha)
+    )
+    assert main_build is not None
+    assert main_build.id_ == pr_build.id_
+    assert [p.name for p in root_dir.iterdir()] == ["a"]
+
