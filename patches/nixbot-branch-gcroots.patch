@@ -0,0 +1,129 @@
+"""Removes the gc-roots of branches the forge has deleted.
+
+Merge-queue branches live seconds to minutes. Their roots only need to
+outlive the default-branch push that reuses the queue build, which
+registers roots of its own. Roots are removed only when the forge
+answers 404 for the branch, so a forge outage keeps them. The default
+branch's roots are never removed, and tag roots are not swept.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import shutil
+from typing import TYPE_CHECKING
+from urllib.parse import quote
+
+from .gcroots import branch_gcroot_dirs
+from .repos import repo_info
+
+if TYPE_CHECKING:
+    from collections.abc import Awaitable, Callable, Iterable
+    from pathlib import Path
+
+    import httpx
+
+    from .forge import GiteaClient, GitHubAppClient, GitlabClient
+    from .repos import RepoRecord
+
+    BranchExists = Callable[[RepoRecord, str], Awaitable[bool | None]]
+
+logger = logging.getLogger(__name__)
+
+_NOT_FOUND = 404
+
+
+def _exists(response: httpx.Response) -> bool | None:
+    if response.status_code == _NOT_FOUND:
+        return False
+    if response.is_success:
+        return True
+    return None
+
+
+async def github_branch_exists(
+    client: GitHubAppClient, project: RepoRecord, branch: str
+) -> bool | None:
+    name = f"{project.owner}/{project.name}"
+    installation_id = await client.installation_for_repo(name)
+    if installation_id is None:
+        return None
+    token = await client.installation_token(installation_id)
+    response = await client.http.get(
+        f"{client.api_url}/repos/{name}/branches/{quote(branch, safe='')}",
+        headers={"Authorization": f"Bearer {token}"},
+    )
+    return _exists(response)
+
+
+async def gitea_branch_exists(
+    client: GiteaClient, project: RepoRecord, branch: str
+) -> bool | None:
+    response = await client.http.get(
+        f"{client.instance_url}/api/v1/repos/{project.owner}/{project.name}"
+        f"/branches/{quote(branch, safe='')}",
+        headers=client.auth_headers(),
+    )
+    return _exists(response)
+
+
+async def gitlab_branch_exists(
+    client: GitlabClient, project: RepoRecord, branch: str
+) -> bool | None:
+    response = await client.http.get(
+        f"{client.project_api_url(project.owner, project.name)}"
+        f"/repository/branches/{quote(branch, safe='')}",
+        headers=client.auth_headers(),
+    )
+    return _exists(response)
+
+
+def forge_branch_exists(
+    github: GitHubAppClient | None,
+    gitea: GiteaClient | None,
+    gitlab: GitlabClient | None,
+) -> BranchExists:
+    """True/False from the project's forge, None when it can't tell."""
+
+    async def check(project: RepoRecord, branch: str) -> bool | None:
+        if project.forge == "github" and github is not None:
+            return await github_branch_exists(github, project, branch)
+        if project.forge == "gitea" and gitea is not None:
+            return await gitea_branch_exists(gitea, project, branch)
+        if project.forge == "gitlab" and gitlab is not None:
+            return await gitlab_branch_exists(gitlab, project, branch)
+        return None
+
+    return check
+
+
+async def sweep_branch_gcroots(
+    gcroots_dir: Path,
+    projects: Iterable[RepoRecord],
+    branch_exists: BranchExists,
+) -> int:
+    """Delete root directories of deleted branches. Returns how many."""
+    removed = 0
+    for project in projects:
+        key = repo_info(project).key
+        for branch, root_dir in branch_gcroot_dirs(gcroots_dir, key).items():
+            if branch == project.default_branch:
+                continue
+            try:
+                exists = await branch_exists(project, branch)
+            except Exception:
+                logger.exception(
+                    "branch lookup failed",
+                    extra={"project": key, "branch": branch},
+                )
+                continue
+            if exists is not False:
+                continue
+            await asyncio.to_thread(shutil.rmtree, root_dir, ignore_errors=True)
+            removed += 1
+            logger.info(
+                "removed gcroots of deleted branch",
+                extra={"project": key, "branch": branch},
+            )
+    return removed
