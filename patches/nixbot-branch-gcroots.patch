--- a/nixbot/gcroots.py
+++ b/nixbot/gcroots.py
@@ -1,10 +1,14 @@
 """GC-root registration, ported from nix_gcroot.py.
 
 The latest successful result of each attribute is protected from
-garbage collection under <gcroots_dir>/<project>/<attr> (in
-production /nix/var/nix/gcroots/per-user/nixbot). Skipped-as-
-already-built attributes are registered too. Re-registration is
-skipped when the root already points at the same store path.
+garbage collection under <gcroots_dir>/<project>/%branches/<branch>/<attr>
+(in production /nix/var/nix/gcroots/per-user/nixbot), or
+%tags/<tag>/<attr> for tag pushes. Skipped-as-already-built attributes
+are registered too. Re-registration is skipped when the root already
+points at the same store path.
+
+Every branch keeps its own roots, so a merge queue never replaces the
+default branch's root for the same attribute.
 """
 
 from __future__ import annotations
@@ -13,7 +17,7 @@ import asyncio
 import logging
 import os
 from typing import TYPE_CHECKING
-from urllib.parse import quote
+from urllib.parse import quote, unquote
 
 if TYPE_CHECKING:
     from pathlib import Path
@@ -45,6 +49,33 @@ def gcroot_path(gcroots_dir: Path, project: str, attr: str) -> Path:
     return gcroots_dir / project / safe_attr_filename(attr)
 
 
+# safe_attr_filename never yields "%b" or "%t", so no attribute root can
+# take these names.
+BRANCHES_DIR = "%branches"
+TAGS_DIR = "%tags"
+
+
+def gcroot_project(project: str, branch: str, tag: str | None = None) -> str:
+    """The project path that a push of `branch` or `tag` registers its
+    roots under."""
+    if tag is not None:
+        return f"{project}/{TAGS_DIR}/{safe_attr_filename(tag)}"
+    return f"{project}/{BRANCHES_DIR}/{safe_attr_filename(branch)}"
+
+
+def branch_gcroot_dirs(gcroots_dir: Path, project: str) -> dict[str, Path]:
+    """Root directories of the project's branches, by branch."""
+    try:
+        entries = list((gcroots_dir / project / BRANCHES_DIR).iterdir())
+    except FileNotFoundError:
+        return {}
+    return {
+        unquote(entry.name): entry
+        for entry in entries
+        if not entry.is_symlink() and entry.is_dir()
+    }
+
+
 def gcroot_already_points_to(gc_root: Path, out_path: str) -> bool:
     try:
         return str(gc_root.readlink()) == out_path
