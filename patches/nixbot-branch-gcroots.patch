diff --git a/nixbot/tests/test_branch_gcroots.py b/nixbot/tests/test_branch_gcroots.py
new file mode 100644
index 0000000..d5b4cc6
--- /dev/null
+++ b/nixbot/tests/test_branch_gcroots.py
@@ -0,0 +1,240 @@
+"""Per-branch gc-roots and the sweep of deleted branches."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+from typing import TYPE_CHECKING, Any, cast
+
+import httpx
+
+from nixbot.branch_gcroots import (
+    gitea_branch_exists,
+    github_branch_exists,
+    gitlab_branch_exists,
+    sweep_branch_gcroots,
+)
+from nixbot.build_reuse import post_process_skipped
+from nixbot.config import BranchConfig, BranchConfigDict
+from nixbot.events import ChangeEvent, RepoInfo
+from nixbot.forge import GitHubAppClient
+from nixbot.gcroots import BRANCHES_DIR, TAGS_DIR, branch_gcroot_dirs, gcroot_project
+
+from .support import gitea_client, gitlab_client
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+    from pathlib import Path
+
+    import pytest
+
+    from nixbot.orchestrator import Orchestrator
+    from nixbot.repos import RepoRecord
+
+QUEUE = "gh-readonly-queue/main/pr-151-fb841fb3"
+
+
+def record(forge: str = "github") -> RepoRecord:
+    return cast(
+        "RepoRecord",
+        SimpleNamespace(
+            id_=1,
+            forge=forge,
+            owner="acme",
+            name="widget",
+            url="https://x",
+            default_branch="main",
+        ),
+    )
+
+
+def test_gcroot_project_layout() -> None:
+    project = "github/acme/widget"
+    assert gcroot_project(project, "main") == f"{project}/{BRANCHES_DIR}/main"
+    # Branch slashes are quoted into one path component.
+    assert gcroot_project(project, QUEUE) == (
+        f"{project}/{BRANCHES_DIR}/gh-readonly-queue%2Fmain%2Fpr-151-fb841fb3"
+    )
+    # Tag pushes carry the tag in `branch` too.
+    assert gcroot_project(project, "v1", "v1") == f"{project}/{TAGS_DIR}/v1"
+
+
+def test_branch_gcroot_dirs_decodes_branches(tmp_path: Path) -> None:
+    project = "github/acme/widget"
+    assert branch_gcroot_dirs(tmp_path, project) == {}
+    queue_dir = tmp_path / gcroot_project(project, QUEUE)
+    main_dir = tmp_path / gcroot_project(project, "main")
+    for root_dir in (
+        queue_dir,
+        main_dir,
+        tmp_path / gcroot_project(project, "v1", "v1"),
+    ):
+        root_dir.mkdir(parents=True)
+    (tmp_path / project / "checks.x.foo").symlink_to("/nix/store/abc")
+    assert branch_gcroot_dirs(tmp_path, project) == {
+        QUEUE: queue_dir,
+        "main": main_dir,
+    }
+
+
+def _orchestrator(tmp_path: Path, registered: list[tuple[str, str]]) -> Orchestrator:
+    async def register(_dir: Path, project: str, attr: str, _out: str) -> None:
+        registered.append((project, attr))
+
+    branches = BranchConfigDict(
+        {
+            "merge-queue": BranchConfig(
+                match_glob="gh-readonly-queue/*",
+                register_gcroots=True,
+                update_outputs=False,
+            ),
+            "releases": BranchConfig(
+                match_glob="release-*",
+                register_gcroots=True,
+                update_outputs=False,
+            ),
+        }
+    )
+    return cast(
+        "Orchestrator",
+        SimpleNamespace(
+            config=SimpleNamespace(
+                branches=branches, gcroots_dir=tmp_path, outputs_path=None
+            ),
+            register_gcroot=register,
+        ),
+    )
+
+
+def _event(branch: str, **kwargs: Any) -> ChangeEvent:
+    repo = RepoInfo(
+        id=1,
+        key="github/acme/widget",
+        name="acme/widget",
+        owner="acme",
+        repo="widget",
+        forge="github",
+        clone_url="",
+        default_branch="main",
+    )
+    return ChangeEvent(repo=repo, branch=branch, commit_sha="c0ffee", **kwargs)
+
+
+async def test_each_branch_and_tag_keeps_its_own_roots(tmp_path: Path) -> None:
+    registered: list[tuple[str, str]] = []
+    o = _orchestrator(tmp_path, registered)
+    await post_process_skipped(o, _event("main"), [("a", "/nix/store/main")])
+    await post_process_skipped(o, _event(QUEUE), [("a", "/nix/store/queue")])
+    # No branch config matches "v1", so it registers nothing.
+    await post_process_skipped(o, _event("v1", tag="v1"), [("a", "/nix/store/tag")])
+    await post_process_skipped(
+        o, _event("release-1", tag="release-1"), [("a", "/nix/store/release")]
+    )
+    project = "github/acme/widget"
+    assert registered == [
+        (gcroot_project(project, "main"), "a"),
+        (gcroot_project(project, QUEUE), "a"),
+        (gcroot_project(project, "release-1", "release-1"), "a"),
+    ]
+
+
+async def test_sweep_removes_only_branches_the_forge_deleted(tmp_path: Path) -> None:
+    project = "github/acme/widget"
+    answers: dict[str, bool | Exception | None] = {
+        # A forge that loses track of the default branch must not cost
+        # it its roots.
+        "main": False,
+        "gone": False,
+        "alive": True,
+        "unknown": None,
+        "error": RuntimeError("forge down"),
+    }
+    dirs = {}
+    for branch in answers:
+        dirs[branch] = tmp_path / gcroot_project(project, branch)
+        dirs[branch].mkdir(parents=True)
+        (dirs[branch] / "a").symlink_to("/nix/store/abc")
+    tag_dir = tmp_path / gcroot_project(project, "v1", "v1")
+    tag_dir.mkdir(parents=True)
+
+    async def exists(_project: RepoRecord, branch: str) -> bool | None:
+        answer = answers[branch]
+        if isinstance(answer, Exception):
+            raise answer
+        return answer
+
+    assert await sweep_branch_gcroots(tmp_path, [record()], exists) == 1
+    assert not dirs["gone"].exists()
+    assert all(dirs[b].exists() for b in ("main", "alive", "unknown", "error"))
+    assert tag_dir.exists()
+
+
+def _status_by_path(statuses: dict[str, int], seen: list[str]) -> httpx.MockTransport:
+    def handler(request: httpx.Request) -> httpx.Response:
+        path = request.url.raw_path.decode()
+        seen.append(path)
+        return httpx.Response(statuses.get(path, 404), json={})
+
+    return httpx.MockTransport(handler)
+
+
+async def test_github_branch_exists(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    base = "/repos/acme/widget/branches/"
+    seen: list[str] = []
+    client = GitHubAppClient(
+        1,
+        tmp_path / "key.pem",
+        http=httpx.AsyncClient(
+            transport=_status_by_path({f"{base}alive": 200, f"{base}flaky": 502}, seen)
+        ),
+        api_url="https://api.github.test",
+    )
+    client.repo_installations["acme/widget"] = 7
+
+    async def token(_installation: int, _repos: object = None) -> str:
+        return "t"
+
+    monkeypatch.setattr(client, "installation_token", token)
+    assert await github_branch_exists(client, record(), "alive") is True
+    assert await github_branch_exists(client, record(), QUEUE) is False
+    assert await github_branch_exists(client, record(), "flaky") is None
+    assert seen[1] == f"{base}gh-readonly-queue%2Fmain%2Fpr-151-fb841fb3"
+
+
+async def test_github_branch_exists_without_installation(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    client = GitHubAppClient(
+        1,
+        tmp_path / "key.pem",
+        http=httpx.AsyncClient(
+            transport=httpx.MockTransport(lambda _r: httpx.Response(404))
+        ),
+    )
+
+    async def no_installation(_name: str) -> int | None:
+        return None
+
+    monkeypatch.setattr(client, "installation_for_repo", no_installation)
+    assert await github_branch_exists(client, record(), QUEUE) is None
+
+
+def _alive_only(suffix: str) -> Callable[[httpx.Request], httpx.Response]:
+    def handler(request: httpx.Request) -> httpx.Response:
+        path = request.url.raw_path.decode()
+        return httpx.Response(200 if path.endswith(suffix) else 404, json={})
+
+    return handler
+
+
+async def test_gitea_branch_exists() -> None:
+    gitea = gitea_client(_alive_only("/api/v1/repos/acme/widget/branches/alive"))
+    assert await gitea_branch_exists(gitea, record("gitea"), "alive") is True
+    assert await gitea_branch_exists(gitea, record("gitea"), "gone") is False
+
+
+async def test_gitlab_branch_exists() -> None:
+    gitlab = gitlab_client(_alive_only("/acme%2Fwidget/repository/branches/alive"))
+    assert await gitlab_branch_exists(gitlab, record("gitlab"), "alive") is True
+    assert await gitlab_branch_exists(gitlab, record("gitlab"), "gone") is False
